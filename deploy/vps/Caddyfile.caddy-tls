# Same as deploy/vps/Caddyfile — kept for docs/scripts that reference this filename after Hydra removal.
# Caddy: automatic HTTPS for {$CADDY_DOMAIN} and hermes.skrr.cloud.

{$CADDY_DOMAIN} {
	encode gzip zstd

	# Optional: Hermes Telegram webhook (merge docker-compose.hermes.yml, set TELEGRAM_WEBHOOK_URL=https://{$CADDY_DOMAIN}/telegram)
	# handle_path /telegram/* {
	# 	reverse_proxy hermes-gateway:8443
	# }

	# Optional: SSE (merge docker-compose.realtime.yml --profile realtime)
	# handle_path /sse {
	# 	reverse_proxy realtime-bridge:8095
	# }

	reverse_proxy dashboard:8501
}

hermes.skrr.cloud {
	encode gzip zstd
	reverse_proxy hermes-gateway:8642
}
