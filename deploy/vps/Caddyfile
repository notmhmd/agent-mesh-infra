# Caddy binds host :80 and :443 (docker-compose.yml). Automatic HTTPS for each site below.
# Set CADDY_DOMAIN in .env (e.g. mesh.skrr.cloud). DNS A records must point to this host.
#
# If TLS terminates at an edge nginx instead, use a variant with only http://{$CADDY_DOMAIN}
# and proxy nginx → caddy:80 — see deploy/vps/README.md "Edge nginx".

{$CADDY_DOMAIN} {
	encode gzip zstd

	# Optional: Hermes Telegram webhook (merge docker-compose.hermes.yml, set TELEGRAM_WEBHOOK_URL=https://{$CADDY_DOMAIN}/telegram)
	# handle_path /telegram/* {
	# 	reverse_proxy hermes-gateway:8443
	# }

	# Optional: SSE (merge docker-compose.realtime.yml --profile realtime)
	# handle_path /sse {
	# 	reverse_proxy realtime-bridge:8095
	# }

	reverse_proxy dashboard:8501
}

# Hermes OpenAI-compatible API (DNS A record for this hostname).
# Gateway must listen on 0.0.0.0:8642 (see deploy/hermes/env.example).
hermes.skrr.cloud {
	encode gzip zstd
	reverse_proxy hermes-gateway:8642
}
