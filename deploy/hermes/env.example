# Copy to gateway-data/.env (and optionally research-data/.env for a second bot).
# Official reference: https://hermes-agent.nousresearch.com/docs/reference/environment-variables
#
# --- Telegram (required for gateway) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs (see https://hermes-agent.nousresearch.com/docs/user-guide/messaging/telegram)
TELEGRAM_ALLOWED_USERS=

# --- Webhook (optional; default is long-polling, no Caddy path needed) ---
# TELEGRAM_WEBHOOK_URL=https://your-domain/telegram
# TELEGRAM_WEBHOOK_PORT=8443
# TELEGRAM_WEBHOOK_SECRET=

# --- LLM (set at least one provider per Hermes docs) ---
# If you only use Gemini, set gateway-data/config.yaml model.provider: gemini and model.default to a bare API id (e.g. gemini-2.5-flash-lite), not gemini/gemini-... (see README).
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# Optional override: HERMES_INFERENCE_PROVIDER=gemini

# --- API server (OpenAI-compatible HTTP — Open WebUI, curl, etc.; not a built-in SPA) ---
# API_SERVER_ENABLED=true
# API_SERVER_HOST=0.0.0.0
# API_SERVER_PORT=8642
# API_SERVER_KEY=generate-a-long-random-secret
# Optional browser access: API_SERVER_CORS_ORIGINS=https://hermes.example.com
