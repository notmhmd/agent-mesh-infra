POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_mesh

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Paper trading (default Alpaca paper base URL if your SDK reads it)
# APCA_API_BASE_URL=https://paper-api.alpaca.markets

# LLM — LiteLLM (use Gemini: set GEMINI_API_KEY and e.g. LLM_MODEL=gemini/gemini-2.0-flash)
LLM_MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=
# Optional alias some setups use:
# GOOGLE_API_KEY=

# Mem0 (optional; merge docker-compose.mem0.yml --profile memory)
MEM0_BASE_URL=
MEM0_API_KEY=
MEM0_USER_ID=agent-mesh
MEM0_AGENT_ID=strategist

# Prometheus scrape ports (compose defaults; set METRICS_PORT=0 in service env to disable)
STRATEGIST_METRICS_PORT=9092
SIGNAL_METRICS_PORT=9093

# OpenTelemetry — strategist, signal-agent, execution (merge docker-compose.otel.yml)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME_STRATEGIST=agent-mesh-strategist
# OTEL_SERVICE_NAME_SIGNAL=agent-mesh-signal
# OTEL_SERVICE_NAME_LEARNING=agent-mesh-learning

# --- Hermes (optional; merge docker-compose.hermes.yml --profile hermes) ---
# Copy deploy/hermes/env.example → deploy/hermes/gateway-data/.env — not these root vars.
# TELEGRAM_BOT_TOKEN / TELEGRAM_ALLOWED_USERS live in gateway-data/.env per Hermes docs.

# Realtime bridge (merge docker-compose.realtime.yml --profile realtime)
# REALTIME_CHANNELS=mesh:mi:new
# REALTIME_TOKEN=

# Caddy (merge docker-compose.vps.yml for TLS hostname). If :80/:443 busy: CADDY_HTTP_PORT=9080 CADDY_HTTPS_PORT=9443
# CADDY_DOMAIN=mesh.example.com
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
